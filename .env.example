# Local development. Copy to .env only when overriding the defaults.
APP_ORIGIN=http://localhost:8000
SESSION_COOKIE_SECURE=false
JOB_TIMEOUT_SECONDS=120

# TODO: link do checkpointu U-Net z main: ________________________________
# Put the downloaded checkpoint in checkpoints/unet_best.pth on the host.
# This is a container path; weights are mounted read-only, never downloaded by the API.
UNET_CHECKPOINT_PATH=/models/unet_best.pth
UNET_MODEL_VERSION=unversioned
UNET_DEVICE=cpu
UNET_THRESHOLD=0.5
